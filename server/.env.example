PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/ticket_management_system
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
CLIENT_URL=http://localhost:5173
COOKIE_SECURE=false

# Optional — if set, uploads go to Cloudinary; otherwise local /uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional SMTP (forgot-password and requester email notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=noreply@tms.local

# 2Factor SMS OTP API Key (Optional — default test key included)
TWOFACTOR_API_KEY=40a61f6f-953e-11f1-9cb1-0200cd936042
